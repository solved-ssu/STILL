# 32자 이상의 임의 문자열. 운영 환경에서는 반드시 별도 비밀값을 사용하세요.
AUTH_PEPPER=replace-with-at-least-32-random-characters

# 선택 사항입니다. 최초 관리자 자동 생성 시에만 세 값을 모두 설정하세요.
# 계정이 하나라도 있으면 무시되며, 최초 로그인 후에는 운영 환경에서 세 값을 제거하세요.
BOOTSTRAP_ADMIN_ID=20260001
BOOTSTRAP_ADMIN_NAME=관리자
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password-2026

# 선택 사항 (기본값: ./data/still.db)
STILL_DATABASE_PATH=./data/still.db

# 선택 사항 (기본값: ./backups)
STILL_BACKUP_DIR=./backups
